
python_version:=$(shell bash -c 'read -p "Enter Python Version:" python_version; echo $$python_version;')

SRCS=cookie.cpp httpconnection.cpp httpdlog.cpp httpheaders.cpp httprequest.cpp \
     httpresponse.cpp threadpool.cpp main.cpp


HDRS=chunkedencoding.h cookie.h debuglog.h httpconnection.h httpdlog.h \
     httprequest.h httpresponse.h largefile.h threadpool.h version.h

CFLAGS:=-std=c++17 -DMAC_TAHOE -DLINUX -I./  \
       -fno-strict-overflow -Wsign-compare  \
       -DNDEBUG -g -O2 -Wall -DPY_SSIZE_T_CLEAN \
       -I/usr/include/python$(python_version)

LIBS:=-ldl -lm -lssl -lcrypto -L/usr/lib/x86_64-linux-gnu/ -L/usr/lib/python3.12/ -lpython$(python_version)

all:httpdwin


httpdwin:
	g++ $(SRCS) -o HttpdWinLinux $(CFLAGS) $(LIBS)

clean:
	rm -f *.o core.* HttpdWinLinux
	
